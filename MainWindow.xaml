<Window x:Class="Schach.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Schach" Height="760" Width="1080" MinHeight="640" MinWidth="900"
        Background="#202329"
        KeyDown="Window_KeyDown">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Neu" Click="NewGameMenuItem_Click" />
                <Separator />
                <MenuItem Header="_Speichern..." Click="SaveGameMenuItem_Click" />
                <MenuItem Header="_Laden..." Click="LoadGameMenuItem_Click" />
                <Separator />
                <MenuItem Header="PGN _exportieren..." Click="ExportPgnMenuItem_Click" />
                <MenuItem Header="PGN _importieren..." Click="ImportPgnMenuItem_Click" />
                <MenuItem Header="FEN e_xportieren..." Click="ExportFenMenuItem_Click" />
                <MenuItem Header="FEN i_mportieren..." Click="ImportFenMenuItem_Click" />
                <MenuItem Header="_Screenshot exportieren..." Click="ExportScreenshotMenuItem_Click" />
                <Separator />
                <MenuItem Header="_Einstellungen..." Click="SettingsMenuItem_Click" />
                <Separator />
                <MenuItem Header="_Beenden" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem Header="_Spiel">
                <MenuItem Header="_Aufgeben" Click="ResignMenuItem_Click" />
                <MenuItem Header="_Remis vereinbaren" Click="DrawMenuItem_Click" />
                <Separator />
                <MenuItem Header="Uhr _pausieren/fortsetzen" Click="PauseClockMenuItem_Click" />
                <Separator />
                <MenuItem Header="Zug _zurueck" Click="PreviousMoveMenuItem_Click" />
                <MenuItem Header="Zug _vor" Click="NextMoveMenuItem_Click" />
            </MenuItem>
        </Menu>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="520" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="#111318"
                BorderThickness="2"
                Background="#111318"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Viewbox x:Name="BoardHost"
                     Stretch="Uniform"
                     Margin="12" />
        </Border>

        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                    <TextBlock Text="Version 1.1"
                           Foreground="#AAB0BA" />
                    <TextBlock Text="Schach"
                           FontSize="34"
                           FontWeight="SemiBold"
                           Foreground="#F4F1E8" />
                <TextBlock Text="Startwege"
                           Margin="0,4,0,0"
                           FontSize="15"
                           Foreground="#AAB0BA" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="0,24,0,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="14"
                            Background="#2B3038"
                            BorderBrush="#3A414C"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Status"
                                       FontSize="13"
                                       Foreground="#AAB0BA" />
                            <TextBlock x:Name="StatusText"
                                       Margin="0,6,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#F4F1E8"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            Background="#252A31"
                            BorderBrush="#333A44"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Letzter Zug"
                                       FontSize="13"
                                       Foreground="#AAB0BA" />
                            <TextBlock x:Name="LastMoveText"
                                       Margin="0,6,0,0"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#F4F1E8"
                                       Text="Noch kein Zug" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            Background="#252A31"
                            BorderBrush="#333A44"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Schachuhr"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#F4F1E8" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Weiss"
                                               FontSize="12"
                                               Foreground="#AAB0BA" />
                                    <TextBlock x:Name="WhiteClockText"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#F4F1E8"
                                               Text="10:00" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Schwarz"
                                               FontSize="12"
                                               Foreground="#AAB0BA" />
                                    <TextBlock x:Name="BlackClockText"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#F4F1E8"
                                               Text="10:00" />
                                </StackPanel>
                            </Grid>
                            <ComboBox x:Name="ClockPresetComboBox"
                                      Margin="0,12,0,0"
                                      Height="34"
                                      SelectionChanged="ClockPresetComboBox_SelectionChanged"
                                      SelectedIndex="2">
                                <ComboBoxItem Content="Bullet 1+0" Tag="1|0" />
                                <ComboBoxItem Content="Blitz 3+2" Tag="3|2" />
                                <ComboBoxItem Content="Standard 10+0" Tag="10|0" />
                                <ComboBoxItem Content="Rapid 15+10" Tag="15|10" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            Background="#252A31"
                            BorderBrush="#333A44"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Geschlagene Figuren"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#F4F1E8" />
                            <TextBlock Text="Von Weiss"
                                       Margin="0,12,0,0"
                                       FontSize="12"
                                       Foreground="#AAB0BA" />
                            <TextBlock x:Name="CapturedByWhiteText"
                                       Margin="0,4,0,0"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="25"
                                       Foreground="#F4F1E8"
                                       Text="-" />
                            <TextBlock Text="Von Schwarz"
                                       Margin="0,12,0,0"
                                       FontSize="12"
                                       Foreground="#AAB0BA" />
                            <TextBlock x:Name="CapturedByBlackText"
                                       Margin="0,4,0,0"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="25"
                                       Foreground="#F4F1E8"
                                       Text="-" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            Background="#252A31"
                            BorderBrush="#333A44"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Zugliste"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#F4F1E8" />
                            <ListBox x:Name="MoveHistoryList"
                                     Margin="0,10,0,0"
                                     MinHeight="160"
                                     MaxHeight="230"
                                     Background="#1D2127"
                                     BorderBrush="#333A44"
                                     Foreground="#F4F1E8" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            Background="#252A31"
                            BorderBrush="#333A44"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="KI-Gegner"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#F4F1E8" />
                            <ComboBox x:Name="GameModeComboBox"
                                      Margin="0,10,0,0"
                                      Height="34"
                                      SelectionChanged="GameModeComboBox_SelectionChanged"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="Mensch gegen Mensch" Tag="HumanVsHuman" />
                                <ComboBoxItem Content="Mensch gegen KI" Tag="HumanVsAi" />
                            </ComboBox>
                            <ComboBox x:Name="AiDifficultyComboBox"
                                      Margin="0,10,0,0"
                                      Height="34"
                                      SelectionChanged="AiDifficultyComboBox_SelectionChanged"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Aus" Tag="Off" />
                                <ComboBoxItem Content="Leicht" Tag="Easy" />
                                <ComboBoxItem Content="Mittel" Tag="Medium" />
                                <ComboBoxItem Content="Schwer" Tag="Hard" />
                            </ComboBox>
                            <ComboBox x:Name="AiSideComboBox"
                                      Margin="0,10,0,0"
                                      Height="34"
                                      SelectionChanged="AiSideComboBox_SelectionChanged"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="KI spielt Weiss" Tag="White" />
                                <ComboBoxItem Content="KI spielt Schwarz" Tag="Black" />
                            </ComboBox>
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#AAB0BA"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="Die KI-Farbe ist konfigurierbar." />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="14"
                            Background="#252A31"
                            BorderBrush="#333A44"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Darstellung"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#F4F1E8" />
                            <ComboBox x:Name="BoardThemeComboBox"
                                      Margin="0,10,0,0"
                                      Height="34"
                                      SelectionChanged="BoardThemeComboBox_SelectionChanged"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Dunkel" Tag="Dark" />
                                <ComboBoxItem Content="Hell" Tag="Light" />
                            </ComboBox>
                            <CheckBox x:Name="AnimationCheckBox"
                                      Margin="4,12,0,0"
                                      Checked="AnimationCheckBox_Changed"
                                      Unchecked="AnimationCheckBox_Changed"
                                      Content="Animationen"
                                      Foreground="#F4F1E8"
                                      IsChecked="True" />
                            <CheckBox x:Name="SoundCheckBox"
                                      Margin="4,8,0,0"
                                      Checked="SoundCheckBox_Changed"
                                      Unchecked="SoundCheckBox_Changed"
                                      Content="Sounds"
                                      Foreground="#F4F1E8" />
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="FlipBoardCheckBox"
                              Margin="4,16,0,0"
                              Checked="FlipBoardCheckBox_Changed"
                              Unchecked="FlipBoardCheckBox_Changed"
                              Content="Brett drehen"
                              Foreground="#F4F1E8"
                              FontSize="14" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Button Height="44"
                        Click="NewGameButton_Click"
                        Content="Neues Spiel"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#E8C16A"
                        Foreground="#171A1F"
                        BorderThickness="0" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="#AAB0BA"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="Tastatur: N startet neu, F dreht das Brett, Esc hebt die Auswahl auf." />
            </StackPanel>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
